{
  "name": "Netflix Executive Analytics",
  "dataColors": [
    "#E50914",
    "#8C8C8C",
    "#F5F5F1",
    "#B81D24",
    "#8C8C8C",
    "#564D4D",
    "#F5A524",
    "#2FB344",
    "#4E79A7"
  ],
  "background": "#0B0B0F",
  "foreground": "#F5F5F1",
  "tableAccent": "#E50914",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#151519"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#2A2A30"
              }
            },
            "radius": 6
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#F5F5F1"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "Left"
          }
        ],
        "legend": [
          {
            "fontColor": {
              "solid": {
                "color": "#D6D6D6"
              }
            },
            "labelColor": {
              "solid": {
                "color": "#D6D6D6"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#151519"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#2A2A30"
              }
            },
            "radius": 6
          }
        ],
        "calloutValue": [
          {
            "fontColor": {
              "solid": {
                "color": "#F5F5F1"
              }
            },
            "fontSize": 28,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#A7A7A7"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "dataPoint": [
          {
            "defaultColor": {
              "solid": {
                "color": "#E50914"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#D6D6D6"
              }
            },
            "fontSize": 9,
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#8C8C8C"
              }
            },
            "fontSize": 8,
            "showAxisTitle": false,
            "gridlineColor": {
              "solid": {
                "color": "#26262C"
              }
            }
          }
        ],
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#F5F5F1"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 3
          }
        ],
        "dataPoint": [
          {
            "defaultColor": {
              "solid": {
                "color": "#E50914"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#D6D6D6"
              }
            },
            "fontSize": 9,
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#8C8C8C"
              }
            },
            "fontSize": 8,
            "showAxisTitle": false,
            "gridlineColor": {
              "solid": {
                "color": "#26262C"
              }
            }
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "Right"
          }
        ],
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#F5F5F1"
              }
            },
            "fontSize": 9,
            "labelStyle": "Category, percent of total"
          }
        ]
      }
    }
  },
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 24,
      "color": "#F5F5F1"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 13,
      "color": "#F5F5F1"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#A7A7A7"
    }
  }
}
